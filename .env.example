# Copy to .env if you need local overrides. Never commit .env or a real key.
# The server starts without these. Keys stay on the server, never in the extension.
# ZENFEED_AI_API_KEY is the OpenAI key for gpt-5-nano (ZF-25). Do not opt in to data sharing.
# Google TTS uses Application Default Credentials on Cloud Run, not a key in this file.

ZENFEED_AI_API_KEY=
ZENFEED_ANALYZE_TIMEOUT_SECONDS=10
ZENFEED_LOG_LEVEL=INFO
