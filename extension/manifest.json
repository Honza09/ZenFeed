{
  "manifest_version": 3,
  "name": "ZenFeed",
  "version": "0.1.0",
  "description": "Personalized web content filtering and summarization.",
  "action": {
    "default_title": "ZenFeed",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
